---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
import '@fontsource-variable/onest';
---

<!doctype html>
<html lang='es'>
	<head>
		<meta charset='UTF-8' />
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('locale');
					var locale = stored === 'en' || stored === 'es' ? stored : 'es';
					document.documentElement.lang = locale;
					document.documentElement.dataset.lang = locale;
				} catch (e) {}
			})();
		</script>
		<meta name='viewport' content='width=device-width' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<link rel='icon' href='/favicon.ico' />
		<meta name='generator' content={Astro.generator} />
		<title>Porfolio de Bruno - Desarrollador y Programador Web FullStack</title>
		<meta
			name='description'
			content='Porfolio de Bruno - Desarrollador y Programador Web FullStack'
		/>
	</head>
	<body>
		<div
			class='absolute top-0 z-[-2] h-screen w-full bg-neutral-950 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]'
		>
		</div>
		<Header />
		<slot />
		<Footer />
	</body>

	<script>
		import { ui, defaultLocale, isLocale, type Locale } from '../i18n/ui';

		function getLocale(): Locale {
			const stored = localStorage.getItem('locale');
			return isLocale(stored) ? stored : defaultLocale;
		}

		function applyLocale(locale: Locale) {
			const dict = ui[locale] ?? ui[defaultLocale];

			document
				.querySelectorAll<HTMLElement>('[data-i18n]')
				.forEach((el) => {
					const key = el.dataset.i18n as keyof typeof dict;
					if (key && key in dict) {
						el.textContent = dict[key];
					}
				});

			document
				.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
					'[data-i18n-placeholder]',
				)
				.forEach((el) => {
					const key = el.dataset.i18nPlaceholder as keyof typeof dict;
					if (key && key in dict) {
						el.placeholder = dict[key];
					}
				});

			document
				.querySelectorAll<HTMLElement>('[data-i18n-aria]')
				.forEach((el) => {
					const key = el.dataset.i18nAria as keyof typeof dict;
					if (key && key in dict) {
						el.setAttribute('aria-label', dict[key]);
					}
				});

			document.documentElement.lang = locale;
			document.documentElement.dataset.lang = locale;
		}

		function setLocale(locale: Locale) {
			localStorage.setItem('locale', locale);
			applyLocale(locale);
			window.dispatchEvent(
				new CustomEvent<Locale>('locale-change', { detail: locale }),
			);
		}

		document.addEventListener('DOMContentLoaded', () => {
			applyLocale(getLocale());
		});

		document
			.querySelectorAll<HTMLButtonElement>('[data-set-locale]')
			.forEach((btn) => {
				btn.addEventListener('click', () => {
					const value = btn.dataset.setLocale;
					if (isLocale(value)) {
						setLocale(value);
					}
				});
			});

		window.addEventListener('locale-change', (e) => {
			if (e instanceof CustomEvent && isLocale(e.detail)) {
				applyLocale(e.detail);
			}
		});
	</script>
</html>

<style is:global>
	:root {
		color-scheme: light dark;
	}

	html {
		font-family: 'Onest Variable', system-ui, sans-serif;
		scroll-behavior: smooth;
	}

	body {
		background: #0a0a0a;
		display: flex;
		flex-direction: column;
		min-height: 100dvh;
		overscroll-behavior: none;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>
